---
const Icon = ({ name, size = 24 }) => {
	const paths = {
		home: '<path d="m3 11 9-9 9 9"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/>',
		file: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"/><polyline points="14 2 14 8 20 8"/><line x1="8" x2="16" y1="13" y2="13"/><line x1="8" x2="16" y1="17" y2="17"/>',
		bell: '<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 17h16c-1.5-1.7-2-3.1-2-7a6 6 0 0 0-12 0c0 3.9-.5 5.3-2 7"/>',
		calendar: '<rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>',
		wallet: '<path d="M20 7V6a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h15v10H5a3 3 0 0 1-3-3V7"/><path d="M16 14h.01"/>',
		users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
		elevator: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M12 7v10"/><path d="m9 9 3-3 3 3"/><path d="m9 15 3 3 3-3"/>',
		phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
		arrow: '<path d="m9 18 6-6-6-6"/>',
		check: '<path d="M20 6 9 17l-5-5"/>',
		menu: '<line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>',
	};
	return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name]}</svg>`;
};
const quickLinks = [
	{ icon: 'file', title: 'Documentos', text: 'Actas, estatutos y circulares', tone: 'sage', href: '#documentos' },
	{ icon: 'wallet', title: 'Cuentas', text: 'Información económica', tone: 'blue', href: '#actualidad' },
	{ icon: 'calendar', title: 'Calendario', text: 'Juntas y fechas importantes', tone: 'sand', href: '#actualidad' },
	{ icon: 'elevator', title: 'Ascensores', text: 'Información para propietarios', tone: 'rose', href: '#ascensores' },
];

const elevatorPortals = [
	{
		name: 'Lisboa 2',
		rows: [
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Izq', rae: '18686', modernization: ['Modernizado (2022-2024)', 'modernized'], oca: [['Desfavorable', 'danger']], date: '15/07/2026', next: 'Ene 2027' },
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Dch', rae: '18685', modernization: ['No modernizado', 'neutral'], oca: [['Desfavorable', 'danger']], date: '15/07/2026', next: 'Ene 2027' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Único', rae: '18684', modernization: ['No modernizado', 'neutral'], oca: [['Holgura', 'danger'], ['Desfavorable', 'danger']], date: '15/07/2026', next: 'Ene 2027' },
		],
	},
	{
		name: 'Amsterdam 10',
		rows: [
			{ staircase: 'Escalera Única', elevator: 'Ascensor Único', rae: '18683', modernization: ['No modernizado', 'neutral'], oca: [['Desfavorable', 'danger']], date: '18/08/2026', next: 'Feb 2027' },
		],
	},
	{
		name: 'Amsterdam 8',
		rows: [
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Único', rae: '18686', modernization: ['Modernizado (2022-2024)', 'modernized'], oca: [['Favorable sin defectos', 'good']], date: '15/07/2026', next: 'Jul 2030' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Izq', rae: '18681', modernization: ['Modernizado TRESA (2019-2021)', 'modernized'], oca: [['Favorable sin defectos', 'good']], date: '15/07/2026', next: 'Jul 2030' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Dch', rae: '18680', modernization: ['Modernizado (2022-2024)', 'modernized'], oca: [['Desfavorable', 'danger']], date: '18/08/2026', next: 'Feb 2027' },
		],
	},
	{
		name: 'Amsterdam 6',
		rows: [
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Izq', rae: '18672', modernization: ['Modernizado TRESA (2019-2021)', 'modernized'], oca: [], date: '—', next: 'Ago 2026' },
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Dch', rae: '18671', modernization: ['No modernizado', 'neutral'], oca: [['Favorable con defectos leves', 'warning']], date: '18/08/2026', next: 'Feb 2027' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Único', rae: '18670', modernization: ['Modernizado (2022-2024)', 'modernized'], oca: [], date: '—', next: 'Ago 2026' },
		],
	},
	{
		name: 'Amsterdam 4',
		rows: [
			{ staircase: 'Escalera Única', elevator: 'Ascensor Único', rae: '18669', modernization: ['Modernizado (2022-2024)', 'modernized'], oca: [['Desfavorable', 'danger']], date: '18/08/2026', next: 'Feb 2027' },
		],
	},
	{
		name: 'Atenas 1',
		rows: [
			{ staircase: 'Escalera Izq', elevator: 'Ascensor Único', rae: '18668', modernization: ['Modernizado (2023-2025)', 'modernized'], oca: [['Desfavorable', 'danger']], date: '18/08/2026', next: 'Feb 2027' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Izq', rae: '18667', modernization: ['Modernizado TRESA (2019-2021)?', 'modernized'], oca: [], date: '—', next: 'Ago 2026' },
			{ staircase: 'Escalera Dch', elevator: 'Ascensor Dch', rae: '18666', modernization: ['Modernizado (2023-2025)', 'modernized'], oca: [], date: '—', next: 'Ago 2026' },
		],
	},
];

const staircaseSpan = (rows: Array<{ staircase: string }>, rowIndex: number) => {
	if (rowIndex > 0 && rows[rowIndex - 1].staircase === rows[rowIndex].staircase) return 0;
	let span = 1;
	while (rows[rowIndex + span]?.staircase === rows[rowIndex].staircase) span++;
	return span;
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Portal de información de la Comunidad de Propietarios Puerta Europa." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Comunidad Puerta Europa</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Lora:wght@500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Puerta Europa, inicio">
				<span class="brand-mark" set:html={Icon({ name: 'home', size: 29 })}></span>
				<span><strong>Puerta Europa</strong><small>Comunidad de propietarios</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a class="active" href="#inicio">Inicio</a><a href="#actualidad">Actualidad</a><a href="#documentos">Documentos</a><a href="#contacto">Contacto</a>
			</nav>
			<button class="menu" aria-label="Abrir menú" aria-expanded="false" set:html={Icon({ name: 'menu' })}></button>
		</header>

		<main id="inicio">
			<section class="hero">
				<div class="hero-copy">
					<span class="eyebrow">Tu comunidad, más cerca</span>
					<h1>Bienvenidos a<br/><em>Puerta Europa</em></h1>
					<p>Un espacio común para consultar información, documentos y novedades de nuestra comunidad de forma clara y sencilla.</p>
					<div class="hero-actions"><a class="button primary" href="#actualidad">Ver novedades <span set:html={Icon({name:'arrow',size:18})}></span></a><a class="button ghost" href="#documentos">Ir a documentos</a></div>
				</div>
				<div class="hero-art">
					<img src="/images/casitas.webp" alt="Ilustración de viviendas y jardines" width="779" height="132" />
				</div>
			</section>

			<section class="quick-grid" aria-label="Accesos rápidos">
				{quickLinks.map((item) => <a href={item.href} class={`quick-card ${item.tone}`}><span class="icon" set:html={Icon({name:item.icon,size:27})}></span><span><strong>{item.title}</strong><small>{item.text}</small></span><span class="go" set:html={Icon({name:'arrow',size:18})}></span></a>)}
			</section>

			<section class="section" id="actualidad">
				<div class="section-heading"><div><span class="eyebrow">Al día</span><h2>Actualidad de la comunidad</h2></div><a href="#">Ver todas <span set:html={Icon({name:'arrow',size:17})}></span></a></div>
				<div class="news-grid">
					<article class="notice featured"><span class="date"><b>18</b> AGO</span><div><span class="tag">Aviso importante</span><h3>Propiedad comunitaria en Puerta Europa</h3><p>Conoce qué zonas son comunitarias y qué conclusiones recoge el informe jurídico.</p><a href="#aviso-propiedad">Leer el aviso <span set:html={Icon({name:'arrow',size:16})}></span></a></div></article>
					<article class="notice"><span class="notice-icon blue" set:html={Icon({name:'calendar'})}></span><div><span class="tag">Mantenimiento</span><h3>Trabajos programados</h3><p>Información sobre las próximas actuaciones en las zonas comunes.</p><small>Actualizado el 12 de agosto</small></div></article>
					<article class="notice"><span class="notice-icon rose" set:html={Icon({name:'bell'})}></span><div><span class="tag">Comunicado</span><h3>Recordatorio a residentes</h3><p>Recomendaciones para el buen uso y disfrute de los espacios compartidos.</p><small>Publicado el 5 de agosto</small></div></article>
				</div>
			</section>

			<section class="community-alert" id="aviso-propiedad">
				<div class="alert-heading">
					<span class="alert-icon" set:html={Icon({name:'bell',size:25})}></span>
					<div><span class="eyebrow">Aviso a propietarios</span><h2>¿Sabes qué parte de Puerta Europa es propiedad de la comunidad?</h2><p>Mira los documentos: hay dos zonas diferentes.</p></div>
				</div>
				<div class="alert-grid">
					<article><span class="alert-number">1</span><h3>El PGOU distingue suelo público y privado</h3><p><strong>RC - Edificación cerrada:</strong> calificación de suelo privado destinada a la edificación residencial.</p><p><strong>EL - Espacios libres públicos:</strong> calificación urbanística de suelo público. No convierte en público todo el espacio colindante.</p></article>
					<article><span class="alert-number">2</span><h3>La documentación notarial refleja dos ámbitos</h3><p><strong>Zona cedida:</strong> la Zona Verde A (ZVA), con 6.742,86 m², se describe como dominio y uso público y de cesión obligatoria y gratuita al Ayuntamiento de Oviedo.</p><p><strong>Finca residencial:</strong> el solar propio A-1/SA-1, de 3.038,83 m², se diferencia de la ZVA. En él se integran el edificio y el resto del solar común.</p></article>
				</div>
				<div class="legal-summary">
					<h3>Conclusiones del informe jurídico encargado por la comunidad</h3>
					<ol>
						<li>La zona situada bajo los soportales, hasta la línea imaginaria de prolongación de las viviendas, es propiedad privada y de uso exclusivo de la comunidad.</li>
						<li>Las licencias municipales de las terrazas no autorizan a clientes ni a trabajadores a atravesar esa zona comunitaria.</li>
						<li>La comunidad, como responsable de sus zonas comunes, puede regular el paso e impedir el acceso de personas ajenas.</li>
						<li>Es posible delimitar la zona privada e instalar un cierre, puerta, verja o control de acceso, respetando los derechos de los propietarios, la accesibilidad, la evacuación y la normativa técnica.</li>
					</ol>
				</div>
				<div class="alert-callout"><strong>¡Atención! El soportal NO es «privado de uso público».</strong><p>La documentación distingue zonas con distinto régimen. La próxima Junta debe decidir cómo proteger la propiedad común y dejar constancia expresa de los usos que la comunidad autoriza.</p></div>
				<div class="alert-actions"><a class="button primary" href="/documentos/aviso-propiedad-comunitaria-puerta-europa.pdf" target="_blank" rel="noopener">Consultar el aviso completo <span set:html={Icon({name:'file',size:18})}></span></a><span>Infórmate · Asiste · Decide</span></div>
				<small class="alert-source">Fuentes: ficha PGOU PE-5 n.º 402; documentación notarial; informe jurídico comunitario (julio de 2026). La delimitación material deberá plasmarse técnicamente.</small>
			</section>

			<section class="documents" id="documentos">
				<div><span class="eyebrow">Siempre disponible</span><h2>Toda la documentación<br/>en un mismo lugar</h2><p>Accede de forma rápida a la información relevante de la comunidad: actas, convocatorias, normativa y comunicaciones.</p><a class="button primary" href="#">Consultar documentos <span set:html={Icon({name:'arrow',size:18})}></span></a></div>
				<div class="paper-stack"><div class="paper back"></div><div class="paper"><span class="paper-icon" set:html={Icon({name:'file',size:34})}></span><span class="line long"></span><span class="line"></span><span class="line short"></span><ul><li><span set:html={Icon({name:'check',size:15})}></span> Actas de reuniones</li><li><span set:html={Icon({name:'check',size:15})}></span> Circulares y avisos</li><li><span set:html={Icon({name:'check',size:15})}></span> Normativa comunitaria</li></ul></div></div>
			</section>

			<section class="elevators" id="ascensores">
				<div class="elevators-heading"><div><span class="eyebrow">Ascensores</span><h2>Estado de ascensores por portal</h2><p>Resumen de modernización y resultados OCA</p></div><span class="elevator-heading-mark" set:html={Icon({name:'elevator',size:64})}></span></div>
				<div class="elevator-board">
					<div class="table-wrap" tabindex="0" aria-label="Tabla desplazable del estado de los ascensores">
						<table class="elevator-table">
							<thead>
								<tr><th rowspan="2">Portal</th><th rowspan="2">Escalera</th><th rowspan="2">Ascensor</th><th rowspan="2"><abbr title="Registro de Aparatos Elevadores">RAE</abbr></th><th rowspan="2">Modernización</th><th colspan="3" class="oca-group">OCA</th></tr>
								<tr><th>Resultado OCA</th><th>Fecha OCA</th><th>Siguiente OCA</th></tr>
							</thead>
							{elevatorPortals.map((portal) => (
								<tbody>
									{portal.rows.map((row, rowIndex) => {
										const stairRows = staircaseSpan(portal.rows, rowIndex);
										return <tr>
											{rowIndex === 0 && <th class="portal-cell" scope="rowgroup" rowspan={portal.rows.length}>{portal.name}</th>}
											{stairRows > 0 && <td class="staircase-cell" rowspan={stairRows}>{row.staircase}</td>}
											<td>{row.elevator}</td>
											<td>{row.rae}</td>
											<td><span class={`status-pill ${row.modernization[1]}`}>{row.modernization[0]}</span></td>
											<td><span class="status-list">{row.oca.length ? row.oca.map((status) => <span class={`status-pill ${status[1]}`}>{status[0]}</span>) : <span class="empty-value">—</span>}</span></td>
											<td>{row.date}</td>
											<td>{row.next}</td>
										</tr>;
									})}
								</tbody>
							))}
						</table>
					</div>
				</div>
				<div class="elevator-note"><span aria-hidden="true">i</span><p>Los resultados OCA corresponden a la última inspección registrada. Los datos proceden de la observación de etiquetas y actas de la comunidad; pueden contener errores. <strong>Información orientativa.</strong></p></div>
			</section>
		</main>

	<footer id="contacto"><div class="footer-brand"><span class="brand-mark" set:html={Icon({name:'home',size:25})}></span><div><strong>Puerta Europa</strong><small>Un espacio para todos</small></div></div><p>¿Necesitas ayuda o tienes alguna consulta?</p><a href="tel:+34000000000"><span set:html={Icon({name:'phone',size:18})}></span> Contactar con la administración</a><small>© 2026 Comunidad de Propietarios Puerta Europa</small></footer>
		<script>
			const button = document.querySelector('.menu');
			const nav = document.querySelector('nav');
			button?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); button.setAttribute('aria-expanded', String(Boolean(open))); });
			document.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => nav?.classList.remove('open')));
		</script>
	</body>
</html>

<style is:global>
	:root{--sage:#879a8a;--sage-dark:#526f60;--sage-pale:#e8eee9;--blue:#9fb3cb;--blue-pale:#e8eef4;--terracotta:#d9987a;--terracotta-dark:#ae5f45;--sand:#d8c7a5;--rose:#d8a6a1;--ink:#20231f;--muted:#6e736e;--cream:#fbfaf7;--line:#e9e3da;--shadow:0 12px 35px rgba(65,55,42,.08);font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--cream)}
	*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 90% 0,#f7eee7 0,transparent 28rem),var(--cream);line-height:1.55}a{color:inherit;text-decoration:none}svg{display:block}button{font:inherit}
	.site-header{height:88px;max-width:1240px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(135,154,138,.22)}.brand{display:flex;align-items:center;gap:13px}.brand-mark{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#9cae9f,#637e6e);box-shadow:0 7px 18px rgba(82,111,96,.2)}.brand strong{font:600 21px/1.1 Lora,serif;display:block}.brand small,.footer-brand small{display:block;color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase;margin-top:3px}.site-header nav{display:flex;align-items:center;gap:34px;font-size:14px}.site-header nav a{position:relative;color:#555c57}.site-header nav a:hover,.site-header nav a.active{color:var(--sage-dark)}.site-header nav a.active:after{content:'';position:absolute;height:2px;background:var(--terracotta);left:0;right:0;bottom:-10px}.menu{display:none;border:0;background:none;color:var(--sage-dark)}
	main{max-width:1240px;margin:auto;padding:0 28px}.hero{min-height:560px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:50px;padding:55px 0 42px}.eyebrow{display:inline-block;color:var(--terracotta-dark);font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;margin-bottom:13px}.hero h1,.section h2,.documents h2{font:600 clamp(43px,5vw,72px)/1.07 Lora,serif;margin:0;letter-spacing:-.035em}.hero h1 em{color:var(--sage-dark);font-style:normal}.hero-copy>p{font-size:17px;color:var(--muted);max-width:590px;margin:25px 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;gap:9px;border-radius:9px;padding:12px 20px;font-size:14px;font-weight:600;transition:.2s}.button:hover{transform:translateY(-2px)}.button.primary{background:var(--sage-dark);color:#fff;box-shadow:0 8px 18px rgba(82,111,96,.2)}.button.ghost{border:1px solid var(--line);background:#fff}.hero-art{position:relative;height:350px;border-radius:52% 48% 12% 15%/44% 42% 18% 15%;overflow:hidden;background:linear-gradient(#f7eee6 0 55%,#dfe8df 55%);box-shadow:inset 0 0 0 1px #efe0d4}.sun{position:absolute;width:100px;height:100px;border-radius:50%;background:#efd7bd;top:32px;right:70px;opacity:.65}.cloud{position:absolute;width:110px;height:20px;border-radius:50%;background:rgba(255,255,255,.6)}.cloud:before,.cloud:after{content:'';position:absolute;border-radius:50%;background:inherit}.cloud:before{width:35px;height:35px;left:20px;bottom:0}.cloud:after{width:50px;height:50px;left:45px;bottom:0}.cloud.one{top:55px;left:45px}.cloud.two{top:95px;right:40px;transform:scale(.7)}.building{position:absolute;bottom:70px;background:#f6eee2;border:2px solid #d9c7b5;display:flex;justify-content:space-around;padding:28px 8px 0;z-index:2;box-shadow:0 8px 14px rgba(70,60,50,.09)}.building:before{content:'';position:absolute;left:-10px;right:-10px;top:-27px;height:30px;background:#b9755e;clip-path:polygon(50% 0,100% 100%,0 100%)}.bu