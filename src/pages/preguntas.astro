	@media(max-width:600px){footer{grid-template-columns:1fr;padding:28px 18px}footer .footer-brand,footer .footer-legal,footer .footer-contact,footer .footer-meta{grid-column:1;grid-row:auto}.footer-contact{align-self:start}}
