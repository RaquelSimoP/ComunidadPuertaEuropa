	*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 92% 0,#f7eee7 0,transparent 29rem),var(--cream);line-height:1.55}a{color:inherit;text-decoration:none}.site-header{height:88px;max-width:1240px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(135,154,138,.22)}.brand{display:flex;align-items:center;gap:13px}.brand-mark{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#9cae9f,#637e6e);font:600 12px Lora,serif;letter-spacing:.08em}.brand strong{font:600 21px/1.1 Lora,serif;display:block}.brand small{display:block;color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase;margin-top:3px}.site-header nav{display:flex;gap:28px;font-size:14px;color:#555c57}.site-header nav a{position:relative}.site-header nav a:hover,.site-header nav .active{color:var(--sage-dark)}.site-header nav .active:after{content:'';position:absolute;left:0;right:0;bottom:-10px;height:2px;background:var(--terracotta)}.mobile-home{display:none}
	main{max-width:1184px;margin:auto;padding:0 28px}.page-intro{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:84px 0 54px}.eyebrow{display:inline-block;color:var(--terracotta-dark);font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;margin-bottom:13px}.page-intro h1{font:600 clamp(44px,5vw,70px)/1.06 Lora,serif;letter-spacing:-.035em;margin:0}.page-intro h1 em{font-style:normal;color:var(--sage-dark)}.page-intro p{max-width:650px;margin:24px 0 0;color:var(--muted);font-size:17px}.intro-mark{width:128px;height:128px;flex:0 0 auto;border-radius:50%;display:grid;place-items:center;background:#f2ded8;color:var(--terracotta-dark);font:600 75px Lora,serif;box-shadow:0 10px 25px rgba(174,95,69,.1)}
	.question-index{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:54px;padding:22px;border:1px solid #e5d7bc;border-radius:20px;background:linear-gradient(145deg,#fffdf8,#f7f0e6)}.question-index a{display:flex;align-items:flex-start;gap:10px;padding:12px;border-radius:10px;color:#4b5b55;font-size:12px;line-height:1.35;transition:background .2s ease,color .2s ease}.question-index a:hover{background:#fff;color:var(--sage-dark)}.question-index span{color:var(--terracotta-dark);font-size:11px;font-weight:600;letter-spacing:.08em;flex:0 0 auto}.answers{display:grid;gap:14px}.answer-card{border:1px solid #e5d7bc;border-radius:17px;background:linear-gradient(145deg,#fffdf8,#f8f3eb);box-shadow:0 7px 22px rgba(84,67,48,.045);scroll-margin-top:24px}.answer-card summary{display:grid;grid-template-columns:48px 1fr 28px;align-items:center;gap:16px;padding:22px 25px;cursor:pointer;list-style:none;font:600 22px/1.25 Lora,serif;color:#1c2b26}.answer-card summary::-webkit-details-marker{display:none}.answer-card summary>b{display:grid;place-items:center;width:28px;height:28px;border:1px solid #cbd7cc;border-radius:50%;color:var(--sage-dark);font:400 21px/1 DM Sans,sans-serif}.answer-card[open] summary>b{transform:rotate(45deg);background:var(--sage-pale)}.answer-number{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#e9eee9;color:var(--sage-dark);font:600 16px Lora,serif}.answer-body{max-width:920px;margin:0 69px 26px;padding-top:18px;border-top:1px solid #e6dfd3;color:#4d5751;font-size:15px}.answer-body p{margin:0 0 15px}.answer-body strong{color:#183d67}.back-link{margin:28px 0 70px;text-align:right}.back-link a{color:var(--sage-dark);font-size:12px;font-weight:600}.back-link a span{font-size:16px;margin-left:3px}footer{border-top:1px solid var(--line);max-width:1240px;margin:auto;padding:30px 28px 42px;display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
	.questions-title{margin:48px 0 18px;color:var(--terracotta-dark);font:600 28px/1.2 Lora,serif}.question-index{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:42px;padding:22px;border:1px solid #e5d7bc;border-radius:20px;background:linear-gradient(145deg,#fffdf8,#f7f0e6)}.question-index a{display:flex;align-items:flex-start;gap:10px;padding:12px;border-radius:10px;color:#4b5b55;font-size:11px;line-height:1.35;transition:background .2s ease,color .2s ease}.question-index a:hover{background:#fff;color:var(--sage-dark)}.question-index span{color:var(--terracotta-dark);font-size:11px;font-weight:600;letter-spacing:.08em;flex:0 0 auto}.answers{display:grid;gap:14px}.answer-card{border:1px solid #e5d7bc;border-radius:17px;background:linear-gradient(145deg,#fffdf8,#f8f3eb);box-shadow:0 7px 22px rgba(84,67,48,.045);scroll-margin-top:24px}.answer-card summary{display:grid;grid-template-columns:48px 1fr 28px;align-items:center;gap:16px;padding:18px 25px;cursor:pointer;list-style:none;font:600 18px/1.25 Lora,serif;color:#1c2b26}.answer-card summary::-webkit-details-marker{display:none}.answer-card summary>b{display:grid;place-items:center;width:28px;height:28px;border:1px solid #d7b8a7;border-radius:50%;color:var(--terracotta-dark);font:400 21px/1 DM Sans,sans-serif}.answer-card[open] summary>b{transform:rotate(45deg);background:#f2ded8}.answer-number{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#f2ded8;color:var(--terracotta-dark);font:600 16px Lora,serif}.answer-body{max-width:920px;margin:0 69px 24px;padding-top:16px;border-top:1px solid #e6dfd3;color:#4d5751;font-size:14px}.answer-body p{margin:0 0 13px}.answer-body strong{color:#183d67}.back-link{margin:28px 0 70px;text-align:right}.back-link a{color:var(--sage-dark);font-size:12px;font-weight:600}.back-link a span{font-size:16px;margin-left:3px}footer{border-top:1px solid var(--line);max-width:1240px;margin:auto;padding:30px 28px 42px;display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
